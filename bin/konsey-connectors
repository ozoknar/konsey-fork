#!/usr/bin/env bash
# Etkin mesaj-platformu connector'larını çalıştır (Telegram vb.).
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -x "$DIR/.venv/bin/python" ] || { echo "Konsey kurulu değil — önce ./install.sh çalıştırın." >&2; exit 1; }
[ -f "$DIR/.env" ] && { set -a; . "$DIR/.env"; set +a; }
exec "$DIR/.venv/bin/python" -m connectors "$@"

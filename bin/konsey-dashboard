#!/usr/bin/env bash
# Symlink üzerinden çağrılsa bile gerçek repo kökünü çöz.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do _d="$(cd -P "$(dirname "$_self")" && pwd)"; _self="$(readlink "$_self")"; case "$_self" in /*) ;; *) _self="$_d/$_self";; esac; done
DIR="$(cd -P "$(dirname "$_self")/.." && pwd)"
"$DIR/.venv/bin/python" -m orchestrator.dashboard || exit 1
# Cross-platform aç (macOS/Linux/diğer)
case "$(uname -s)" in
  Darwin) open "$DIR/dashboard.html" 2>/dev/null || true ;;
  Linux)  xdg-open "$DIR/dashboard.html" 2>/dev/null || true ;;
  *)      echo "dashboard hazır: $DIR/dashboard.html" ;;
esac

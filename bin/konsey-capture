#!/usr/bin/env bash
# Stop hook → oturum işaretçisi bırakır (bir sonraki launchd tick distile eder).
# DAİMA exit 0: hiçbir koşulda oturumu bloklamaz/kıramaz.
# Recursion guard: YALNIZ KONSEY_DISTILL env (F1: .distilling lock kaldırıldı — meşru
# eşzamanlı oturumu düşürüyordu = audit kaybı; recursion zaten env ile engelli).
[ -n "$KONSEY_DISTILL" ] && exit 0
# Symlink üzerinden çağrılsa bile gerçek repo kökünü çöz.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do _d="$(cd -P "$(dirname "$_self")" && pwd)"; _self="$(readlink "$_self")"; case "$_self" in /*) ;; *) _self="$_d/$_self";; esac; done
ROOT="$(cd -P "$(dirname "$_self")/.." && pwd)"   # script konumundan çöz (hardcoded değil)
[ -x "$ROOT/.venv/bin/python" ] || exit 0
( cd "$ROOT" 2>/dev/null && "$ROOT/.venv/bin/python" -m orchestrator.capture hook ) 2>/dev/null
exit 0

#!/usr/bin/env bash
# Kurulum/sağlayıcı/auth durumunu göster.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -x "$DIR/.venv/bin/python" ] || { echo "Konsey kurulu değil — önce ./install.sh çalıştırın." >&2; exit 1; }
[ -f "$DIR/.env" ] && { set -a; . "$DIR/.env"; set +a; }
exec "$DIR/.venv/bin/python" -m orchestrator.doctor

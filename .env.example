# Konsey yapılandırması — `cp .env.example .env` (install.sh otomatik yapar).
# Tüm değerler opsiyoneldir; varsayılanlar makuldür.

# ── Güvenlik seviyesi: akışkanlık ↔ güvenlik dengesi ──────────────────
#   strict  = secret + PHI bloklar, phi/prod insan onayı, ≥2 sağlayıcı
#   medium  = secret bloklar, PHI uyarır (önerilen, dengeli)
#   weak    = yalnız uyarır, hiçbir şeyi bloklamaz (max akışkanlık)
KONSEY_SECURITY_LEVEL=medium

# Çalışmak için gereken min. bağımsız sağlayıcı (boşsa: strict→2, diğer→1).
# KONSEY_PROVIDERS_MIN=1

# ── Telemetri (opt-in; varsayılan KAPALI) ───────────────────────────
# Yalnız anonim metadata gönderir; ASLA görev içeriği/PHI/secret. Bkz. PRIVACY.md.
KONSEY_TELEMETRY=off
# Açıksa veri buraya gider (varsayılan resmi backend). Kendi backend'iniz için override edin:
# KONSEY_TELEMETRY_ENDPOINT=https://konsey-telemetry-production.up.railway.app/v1/events

# ── Genel ───────────────────────────────────────────────────────────
KONSEY_USER=local
# KONSEY_DB=/abs/path/council.duckdb

# Otonom dispatch/recall köprü dizini (inbox/outbox/queue-human/recall-cache).
# KONSEY_BRIDGE_DIR=~/.konsey/bridge

# Opsiyonel sağlık/PHI preset'i: kendi proje adlarınız (regex, | ile ayrılır).
# KONSEY_PHI_PROJECTS=projem|baska-proje

# keychain helper servis adları (boşlukla ayrılır).
# KONSEY_KEYCHAIN_SERVICES="konsey-anthropic konsey-openai konsey-google"

# A2A: loopback dışı (public) bind için ZORUNLU kimlik doğrulama token'ı.
# KONSEY_A2A_TOKEN=uzun-rastgele-bir-deger

# ── Dil (i18n) ──────────────────────────────────────────────────────
# Varsayılan: sistem locale tr ise Türkçe, değilse İngilizce. Zorlamak için:
# KONSEY_LANG=en

# ── Connectors (sohbet platformları, opt-in) ───────────────────────
# Telegram bot token (@BotFather). connectors.toml'da enabled=true ile aktif.
# TELEGRAM_BOT_TOKEN=123456:ABC...

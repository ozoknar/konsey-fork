# Konsey yapılandırması — `cp .env.example .env` ve gerektiğinde düzenleyin.
# Tüm değerler opsiyoneldir; varsayılanlar makuldür.

# Çalışmak için gereken minimum bağımsız sağlayıcı sayısı.
#   1 = solo mod (sadece Claude yeter) · 2+ = sıkı çapraz-doğrulama
KONSEY_PROVIDERS_MIN=1

# Audit kayıtlarında görünecek kullanıcı etiketi.
KONSEY_USER=local

# Audit DB yolu (varsayılan: repo kökünde council.duckdb).
# KONSEY_DB=/abs/path/council.duckdb

# Opsiyonel sağlık/PHI preset'i: kendi proje adlarınız (regex, | ile ayrılır).
# Bu adlar tek başına bloklamaz; yalnız "gerçek veri gönderme" notu düşer.
# KONSEY_PHI_PROJECTS=projem|baska-proje

# keychain helper'ın beklediği servis adları (boşlukla ayrılır).
# KONSEY_KEYCHAIN_SERVICES=konsey-anthropic konsey-openai konsey-google
